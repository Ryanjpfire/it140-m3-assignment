START paycheck_calculator

    TODO: Obtain the required program input.

    IF hoursworked > 40 THEN
        LET regularPay = 40 * 20
        LET overtimePay = (hoursworked - 40) * 30
        LET totalPay = regularPay + overtimePay
    ELSE
        LET totalPay = hoursworked * 20
    ENDIF

    PUT totalPay

END paycheck_calculator


